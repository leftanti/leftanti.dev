---
/**
 * IntelDigest — the digest list, shared by /intel and every /intel/<kind> view.
 *
 * LINKS OUT, ALWAYS. A headline, a source, a timestamp, and a short snippet.
 * The full article stays where its author put it.
 *
 * Rows are coloured by *kind*, not by source. Twenty feeds against a handful of
 * hues does not fit, and a per-source hue would mean green stood for both
 * DetectionEngineering and some vendor — which is the one thing the palette
 * rule forbids. What an item is tells you more at a glance than who published
 * it anyway.
 *
 * The source still leads each row, as the table name.
 */
import QueryLines from './QueryLines.astro';
import { intelKind } from '../config/intel-kinds.mjs';

interface IntelItem {
  id: string;
  title: string;
  url: string;
  source: string;
  published: string;
  summary: string;
  kind: string;
  matched: string[];
  indicators: {
    v: number;
    hashes: number;
    defanged: number;
    addresses: number;
    heading: boolean;
    evidence: number;
  } | null;
}

/**
 * How much there is to harvest, in one pill. Counts come from scanning the
 * linked article, so this says what is actually in it rather than guessing
 * from the publisher — which is the difference between a report worth opening
 * for a block list and one that merely reads like it might be.
 */
function indicatorPill(indicators: IntelItem['indicators']): string | null {
  if (!indicators) return null;
  const parts: string[] = [];
  // Addresses lead: they are the thing that gets copied out and blocked, so
  // the count is what decides whether a report is worth opening today.
  if (indicators.addresses > 0) parts.push(`${indicators.addresses} ip`);
  if (indicators.hashes > 0) parts.push(`${indicators.hashes} hashes`);
  return parts.length > 0 ? parts.join(' · ') : null;
}

interface Props {
  items: IntelItem[];
  emptyMessage?: string;
}

const { items, emptyMessage = 'Nothing here yet.' } = Astro.props;

/** `2026-08-09 08:43` — a digest needs the time, unlike a dated entry. */
function stamp(iso: string): string {
  return new Date(iso).toISOString().slice(0, 16).replace('T', ' ');
}
---

{
  items.length === 0 ? (
    <p class="digest__empty">{emptyMessage}</p>
  ) : (
    <ol class="digest" role="list">
      {items.map((item) => {
        const kind = intelKind(item.kind);
        return (
          <li>
            <QueryLines
              tableName={item.source}
              accent={`var(${kind.colorVar})`}
              title={item.title}
              href={item.url}
              meta={`${stamp(item.published)} UTC`}
              description={item.summary}
              tags={[
                { label: kind.label.toLowerCase(), href: `/intel/${kind.key}` },
                ...(indicatorPill(item.indicators)
                  ? [{ label: indicatorPill(item.indicators)! }]
                  : []),
                ...item.matched.slice(0, 1).map((label) => ({ label })),
              ]}
              headingLevel={2}
              external={true}
            />
          </li>
        );
      })}
    </ol>
  )
}

<style>
  .digest {
    display: flex;
    flex-direction: column;
    gap: var(--timeline-entry-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .digest__empty {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--text-comment);
  }
</style>
