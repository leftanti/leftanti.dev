---
/**
 * QueryLines — the site's signature component.
 *
 * Renders one entry as a miniature KQL query. The section name sits where a
 * Sentinel table name would go, the title is piped off it, and the metadata is
 * a commented-out pipe stage below:
 *
 *   KqlLibrary
 *   | Detecting OAuth device code phishing
 *   //| 2026-08-04  [SigninLogs] [T1528]
 *
 * Used in two places, and deliberately only defined once:
 *   - `as="link"`   a row in a timeline, title links to the entry
 *   - `as="title"`  the heading of that entry's own page, title is plain text
 *
 * They share this file because the alignment below is load-bearing and a second
 * copy of it would drift the first time either was touched.
 *
 * ALIGNMENT (the part that breaks if you touch it carelessly):
 * the `|` line and the `//|` line both start at the same left edge. `//`
 * occupies the first two character cells, so the comment line's pipe lands
 * exactly two glyphs right of the title line's pipe — the same shift you get
 * when you comment a line out in an editor. This only holds while every glyph
 * on both lines shares --font-mono and --fs-pipe. Do not give the `//` or
 * either `|` its own font-size.
 *
 * Every metadata field is optional. Rows and pills are omitted entirely when
 * the entry has no value for them; nothing renders empty.
 */
import { getSection } from '../config/sections';
import { formatDate, type TimelineTag } from '../lib/timeline';
import TagPill from './TagPill.astro';

interface Props {
  /** Section key — supplies the table name and the hue. */
  section?: string;

  title: string;
  href: string;
  date?: Date;
  tags?: TimelineTag[];

  /** Heading level for the title, so page heading hierarchy stays correct. */
  headingLevel?: 1 | 2 | 3;

  /**
   * `row` for a timeline row, `heading` for the entry's own page heading —
   * a page's own title is not a link to itself.
   *
   * Deliberately not named `as`: that is a TypeScript keyword, and using it in
   * the props destructure below stops Astro binding this interface to
   * Astro.props at all, silently leaving every prop typed `any`.
   */
  variant?: 'row' | 'heading';

  /** Turns the table name into a link to the section listing. */
  linkSection?: boolean;

  /**
   * Hide the table-name line. Set on section listings, where the page's own
   * heading is the table name and every row would otherwise repeat it. The
   * rows then pipe off that heading and the page reads as one query.
   */
  showTable?: boolean;

  /** Table name override — a group name on a listing, a resource category. */
  tableName?: string;

  /** Accent for the table name and pipe. Defaults to the section hue. */
  accent?: string;

  /**
   * Plain metadata text, used in place of a date. Rendered `nowrap`, like a
   * date is — keep it short. Anything sentence-length belongs in `description`.
   */
  meta?: string;

  /**
   * A wrapping line beneath the metadata, in the same column. For a snippet or
   * a one-line summary, which would otherwise force the metadata row to scroll.
   */
  description?: string;

  /** Outbound link: opens in a new tab and drops the referrer. */
  external?: boolean;
}

const {
  section: sectionKey,
  title,
  href,
  date,
  tags = [],
  headingLevel = 2,
  variant = 'row',
  linkSection = false,
  showTable = true,
  tableName,
  accent,
  meta,
  description,
  external = false,
} = Astro.props;

const section = sectionKey ? getSection(sectionKey) : null;

const tableLabel = tableName ?? section?.name ?? '';

// Anything without a section is chrome rather than content, so it stays
// neutral — only sections own a hue.
const accentColor = accent ?? (section ? `var(${section.colorVar})` : 'var(--text-dim)');

const Heading = `h${headingLevel}` as 'h1' | 'h2' | 'h3';
const hasMeta = Boolean(date) || Boolean(meta) || Boolean(description) || tags.length > 0;
const externalAttrs = external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<article class="entry" style={`--section-color: ${accentColor};`}>
  {
    showTable &&
      (linkSection && section?.route ? (
        <p class="entry__table">
          <a class="entry__table-link" href={section.route}>
            {tableLabel}
          </a>
        </p>
      ) : (
        <p class="entry__table">{tableLabel}</p>
      ))
  }

  <Heading class="entry__row">
    <span class="glyph glyph--pipe" aria-hidden="true">|</span>
    {
      variant === 'row' ? (
        <a class="entry__title" href={href} {...externalAttrs}>
          {title}
        </a>
      ) : (
        <span class="entry__title">{title}</span>
      )
    }
  </Heading>

  {
    hasMeta && (
      <p class="entry__row entry__row--comment">
        <span class="glyph glyph--mark" aria-hidden="true">//</span>
        <span class="glyph glyph--pipe-comment" aria-hidden="true">|</span>
        <span class="entry__meta">
          {date && (
            <time class="entry__date" datetime={date.toISOString()}>
              {formatDate(date)}
            </time>
          )}
          {meta && <span class="entry__date">{meta}</span>}
          {tags.length > 0 && (
            <span class="entry__tags">
              {tags.map((tag) => (
                <TagPill label={tag.label} href={tag.href} />
              ))}
            </span>
          )}
          {description && <span class="entry__note">{description}</span>}
        </span>
      </p>
    )
  }
</article>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--timeline-line-gap);
  }

  /* --- Line 1: the table name ------------------------------------------ */

  .entry__table {
    font-family: var(--font-mono);
    font-size: var(--fs-mark);
    font-weight: var(--fw-medium);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-normal);
    color: var(--section-color);
    max-width: none;
  }

  .entry__table-link {
    color: inherit;
    text-decoration: none;
  }

  .entry__table-link:hover {
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-decoration-thickness: var(--underline-thickness);
    text-underline-offset: var(--underline-offset);
  }

  /* --- Lines 2 and 3: the pipe stages ---------------------------------- */

  .entry__row {
    display: flex;
    align-items: baseline;
    margin: 0;
    max-width: none;
  }

  /* Every glyph in the gutter shares one font and one size. That is what
     keeps the two pipes exactly two character cells apart. */
  .glyph {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-pipe);
    font-weight: var(--fw-normal);
    line-height: var(--lh-snug);
    user-select: none;
  }

  .glyph--pipe {
    color: var(--section-color);
  }

  .glyph--mark {
    color: var(--comment-mark);
  }

  .glyph--pipe-comment {
    color: var(--pipe-comment);
  }

  /* --- The content that follows each pipe ------------------------------ */

  /* Identical offset on both rows, so the text columns stay a clean two
     cells apart rather than drifting. */
  .entry__title,
  .entry__meta {
    margin-inline-start: var(--timeline-pipe-gap);
  }

  .entry__title {
    font-family: var(--font-sans);
    font-size: var(--fs-title);
    font-weight: var(--fw-medium);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    color: var(--text);
    text-decoration: none;
    text-wrap: pretty;
  }

  /* The page's own heading carries more weight than a row in a list. */
  h1.entry__row .entry__title {
    font-size: var(--fs-h1);
    font-weight: var(--fw-semibold);
  }

  a.entry__title:hover {
    text-decoration: underline;
    text-decoration-color: var(--text-comment);
    text-decoration-thickness: var(--underline-thickness);
    text-underline-offset: var(--underline-offset);
  }

  .entry__meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--timeline-meta-gap);
  }

  .entry__date {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    line-height: var(--lh-snug);
    color: var(--text-comment);
    white-space: nowrap;
  }

  .entry__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pill-gap);
  }

  /* Takes a whole row of the metadata column, so it sits under the date rather
     than beside it, and wraps — unlike .entry__date, which is nowrap because a
     date should never break. Sentence-length text here would otherwise push the
     row wider than the page. */
  .entry__note {
    flex-basis: 100%;
    max-width: var(--measure);
    margin-block-start: var(--space-3xs);
    font-family: var(--font-mono);
    font-size: var(--fs-tiny);
    line-height: var(--lh-snug);
    color: var(--text-comment);
    white-space: normal;
  }
</style>
