---
/**
 * Timeline — a list of TimelineEntry rows.
 *
 * Used by the home page, section listing pages, and tag pages. Callers pass
 * already-sorted items; this component only handles layout.
 */
import TimelineEntry from './TimelineEntry.astro';
import type { TimelineItem } from '../lib/timeline';

interface Props {
  items: TimelineItem[];
  headingLevel?: 2 | 3;
  /** Shown in place of the list when there is nothing to render. */
  emptyMessage?: string;
}

const { items, headingLevel = 2, emptyMessage = 'No entries yet.' } = Astro.props;
---

{
  items.length === 0 ? (
    <p class="timeline__empty">{emptyMessage}</p>
  ) : (
    <ol class="timeline" role="list">
      {items.map((item) => (
        <li class="timeline__item">
          <TimelineEntry {...item} headingLevel={headingLevel} />
        </li>
      ))}
    </ol>
  )
}

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--timeline-entry-gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline__empty {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--text-comment);
  }
</style>
