---
/**
 * SectionLayout — a section's landing page, whatever collection it lists.
 *
 * Every listing page is a thin wrapper around this. Two optional behaviours
 * cover what the sections actually need:
 *
 *   showTags   a "filter by" row of every pill used in this section, linking
 *              to its tag page. Browsing KQL by data table is the whole point
 *              of that library.
 *
 *   groupBy    puts a grouping value where the section name would go — cheat
 *              sheets show `BTL2`, because that is how you revise.
 *
 * THE TABLE NAME ON A LISTING
 * Repeating the section name on every row is noise on a page that already
 * says it. So:
 *
 *   ungrouped   rows carry no table name at all. The page heading is the
 *               table name and the rows pipe off it, which makes the whole
 *               listing read as one query.
 *
 *   grouped     each row's table name is its group value, and the pill that
 *               would repeat that value is dropped.
 *
 * Adding a collection means copying a five-line wrapper, not writing a page.
 */
import BaseLayout from './BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import TagPill from '../components/TagPill.astro';
import type { Section } from '../config/sections';
import { collectTags, type TimelineItem } from '../lib/timeline';

interface Props {
  section: Section;
  items: TimelineItem[];

  /** Show the row of tag links above the list. */
  showTags?: boolean;

  /**
   * Group entries under subheadings. Returns the group name for an entry, or
   * null to place it under `ungroupedLabel`.
   */
  groupBy?: (item: TimelineItem) => string | null;

  /** Heading for entries `groupBy` returned null for. */
  ungroupedLabel?: string;

  /**
   * A link to a curated directory of this section — e.g. detections browsable
   * by MITRE technique or data table, rather than just newest-first. Optional:
   * most sections have nothing worth a second view.
   */
  browseLink?: { label: string; href: string };
}

const {
  section,
  items,
  showTags = false,
  groupBy,
  ungroupedLabel = 'Other',
  browseLink,
} = Astro.props;

const tags = showTags ? collectTags(items) : [];

// Insertion order is preserved, and items arrive newest-first, so groups come
// out ordered by their most recent entry, and entries stay newest-first inside
// each one.
let rows = items;

if (groupBy) {
  const groups = new Map<string, TimelineItem[]>();

  for (const item of items) {
    const name = groupBy(item) ?? ungroupedLabel;
    const bucket = groups.get(name);
    if (bucket) bucket.push(item);
    else groups.set(name, [item]);
  }

  rows = [...groups.entries()].flatMap(([name, groupItems]) =>
    groupItems.map((item) => ({
      ...item,
      // The group value takes the table name slot.
      tableName: name,
      // …which makes a pill repeating it redundant.
      tags: (item.tags ?? []).filter((tag) => tag.label !== name),
    }))
  );
}

const count = items.length;
const countLabel = `${count} ${count === 1 ? 'entry' : 'entries'}`;
---

<BaseLayout title={section.name} description={section.blurb}>
  <header class="listing__header" style={`--section-color: var(${section.colorVar});`}>
    <h1 class="listing__title">{section.name}</h1>
    <p class="listing__blurb">{section.blurb}</p>
  </header>

  {
    tags.length > 0 && (
      <nav class="listing__tags" aria-label="Filter by tag">
        <span class="listing__tags-label" aria-hidden="true">
          //| filter
        </span>
        <span class="listing__tags-list">
          {tags.map((tag) => (
            <TagPill label={tag.label} href={tag.href} />
          ))}
        </span>
      </nav>
    )
  }

  {
    browseLink && (
      <p class="listing__browse">
        <span aria-hidden="true">//|</span>{' '}
        <a href={browseLink.href}>{browseLink.label} →</a>
      </p>
    )
  }

  <!-- On an ungrouped listing this is the last comment line before the pipe
       stages, so it hugs the list and the page reads as one query. -->
  <p class:list={['listing__count', !groupBy && 'listing__count--tight']}>
    <span aria-hidden="true">//</span> {countLabel}
  </p>

  <Timeline
    items={rows}
    headingLevel={2}
    showTable={Boolean(groupBy)}
    emptyMessage="Nothing here yet."
  />
</BaseLayout>

<style>
  .listing__header {
    margin-block-end: var(--space-2xl);
  }

  .listing__title {
    font-family: var(--font-mono);
    font-size: var(--fs-h2);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-normal);
    color: var(--section-color);
  }

  .listing__blurb {
    margin-block-start: var(--space-md);
    max-width: var(--measure);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-dim);
  }

  .listing__tags {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--timeline-meta-gap);
    margin-block-end: var(--space-xl);
    padding-block: var(--space-md);
    border-block: var(--stroke) solid var(--border-faint);
  }

  .listing__tags-label {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    line-height: var(--lh-snug);
    color: var(--text-comment);
    user-select: none;
  }

  .listing__tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pill-gap);
  }

  .listing__browse {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    line-height: var(--lh-snug);
    color: var(--text-comment);
    margin-block-end: var(--space-xl);
  }

  .listing__browse a {
    color: var(--text-dim);
    text-decoration: none;
  }

  .listing__browse a:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: var(--underline-thickness);
    text-underline-offset: var(--underline-offset);
  }

  .listing__count {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    line-height: var(--lh-snug);
    color: var(--text-comment);
    margin-block-end: var(--space-xl);
  }

  .listing__count--tight {
    margin-block-end: var(--timeline-line-gap);
  }

  .listing__empty {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--text-comment);
  }
</style>
