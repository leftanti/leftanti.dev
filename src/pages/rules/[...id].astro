---
/** /rules/<id> — one detection write-up. Thin wrapper; see EntryLayout. */
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getSection } from '../../config/sections';
import { isPublished, itemForEntry } from '../../lib/timeline';

export async function getStaticPaths() {
  const entries = await getCollection('rules');
  return entries
    .filter((entry) => isPublished(entry.data))
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'rules'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const section = getSection('rules');
---

<EntryLayout item={itemForEntry(section, entry)} description={entry.data.description}>
  <Content />
</EntryLayout>
