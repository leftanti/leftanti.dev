---
/**
 * /detections/<id> — one query or rule.
 *
 * A thin wrapper around EntryLayout, same shape as every other detail page.
 *
 * `[...id]` rather than `[id]` because the glob loader derives ids from paths,
 * so entries filed in subfolders have slashes in them.
 */
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getSection } from '../../config/sections';
import { isPublished, itemForEntry } from '../../lib/timeline';

export async function getStaticPaths() {
  const entries = await getCollection('detections');
  return entries
    .filter((entry) => isPublished(entry.data))
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'detections'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const section = getSection('detections');
---

<EntryLayout item={itemForEntry(section, entry)} description={entry.data.description}>
  <Content />
</EntryLayout>
