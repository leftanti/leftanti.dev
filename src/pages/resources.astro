---
/**
 * /resources — curated external links, grouped into collapsible categories,
 * each optionally split into collapsible subcategories.
 *
 * Everything on this page comes from src/data/resources.json. Adding a link is
 * a row in that file; adding a category or a subcategory is an object in it.
 * This page never needs editing to add any of them.
 *
 * COLLAPSING, TWO LEVELS DEEP
 * Built on native <details>/<summary>, nested — a subcategory is just a
 * <details> inside a <details>, which HTML has always supported natively. No
 * JavaScript at either level: expanding costs nothing, works with the
 * keyboard, and announces its own state to a screen reader. This page ships
 * zero client JS, unlike the entry pages which ship the copy button.
 *
 * A category has either `links` directly, or `subcategories` that each carry
 * their own `links` — see the schema in content.config.ts. Flat suits a short
 * list; subcategories suit one that has grown enough to want a second click
 * before the list, e.g. Tools split into OSINT / Malware Analysis / Network.
 *
 * Categories and subcategories both start closed: the point of the page is to
 * stay scannable as the list grows, and a collapsed one still shows its name,
 * its count, and what is inside it. Add `open` in the data to default one open.
 *
 * Rendered in the site's own idiom: the category name sits where a table name
 * goes and each link is piped off it.
 *
 * COLOUR
 * A category carries a hue on exactly the two things a section colours — its
 * name and its pipe glyphs — and nothing else. The hue is not a new one: each
 * category borrows the colour of the section it relates to. Subcategories
 * inherit their parent's hue rather than choosing their own — they group
 * within one category, they do not own a colour.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import QueryLines from '../components/QueryLines.astro';

const DESCRIPTION =
  'Curated external links for threat intel, KQL, detection engineering, DFIR, training, and tooling.';

// The loader returns entries sorted by id, so the authored order in the JSON
// is restored here from the explicit `order` field.
const categories = (await getCollection('resources')).sort((a, b) => a.data.order - b.data.order);

/** `https://www.cisa.gov/known-…` -> `cisa.gov` */
function domainOf(url: string): string {
  return new URL(url).hostname.replace(/^www\./, '');
}

/** `cisa.gov — the list that matters` — the domain first, so it scans. */
function metaFor(url: string, note?: string): string {
  const domain = domainOf(url);
  return note ? `${domain} — ${note}` : domain;
}

/** Total links in a category, whichever shape it uses. */
function countOf(category: (typeof categories)[number]): number {
  return category.data.links?.length ?? category.data.subcategories?.reduce((n, s) => n + s.links.length, 0) ?? 0;
}

const linkCount = categories.reduce((n, c) => n + countOf(c), 0);
---

<BaseLayout title="Resources" description={DESCRIPTION}>
  <header class="page-head">
    <h1 class="page-head__title">Resources</h1>
    <p class="page-head__sub">
      <span aria-hidden="true">//</span> {linkCount} links in {categories.length} categories, all of
      them somebody else's work
    </p>
  </header>

  <div class="categories">
    {
      categories.map((category) => (
        <details class="category" style={`--category-color: var(${category.data.colorVar});`}>
          <summary class="category__summary">
            <span class="category__head">
              <span class="category__marker" aria-hidden="true" />
              <span class="category__name">{category.data.title}</span>
              <span class="category__count">{countOf(category)}</span>
            </span>
            <span class="category__blurb">
              <span aria-hidden="true">//</span> {category.data.blurb}
            </span>
          </summary>

          <div class="category__body">
            {category.data.links && (
              <ol class="link-list" role="list">
                {category.data.links.map((link) => (
                  <li>
                    <QueryLines
                      showTable={false}
                      accent={`var(${category.data.colorVar})`}
                      title={link.title}
                      href={link.url}
                      meta={metaFor(link.url, link.note)}
                      headingLevel={3}
                      external={true}
                    />
                  </li>
                ))}
              </ol>
            )}

            {category.data.subcategories && (
              <div class="subcategories">
                {category.data.subcategories.map((sub) => (
                  <details class="subcategory">
                    <summary class="subcategory__summary">
                      <span class="subcategory__marker" aria-hidden="true" />
                      <span class="subcategory__name">{sub.title}</span>
                      <span class="category__count">{sub.links.length}</span>
                      {sub.blurb && <span class="subcategory__blurb">{sub.blurb}</span>}
                    </summary>

                    <ol class="link-list" role="list">
                      {sub.links.map((link) => (
                        <li>
                          <QueryLines
                            showTable={false}
                            accent={`var(${category.data.colorVar})`}
                            title={link.title}
                            href={link.url}
                            meta={metaFor(link.url, link.note)}
                            headingLevel={3}
                            external={true}
                          />
                        </li>
                      ))}
                    </ol>
                  </details>
                ))}
              </div>
            )}
          </div>
        </details>
      ))
    }
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-block-end: var(--space-2xl);
  }

  .page-head__title {
    font-family: var(--font-mono);
    font-size: var(--fs-h2);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-normal);
    color: var(--text);
  }

  .page-head__sub {
    margin-block-start: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    line-height: var(--lh-snug);
    color: var(--text-comment);
    max-width: var(--measure);
  }

  .categories {
    display: flex;
    flex-direction: column;
  }

  .category {
    border-block-start: var(--stroke) solid var(--border-faint);
    padding-block: var(--space-lg);
  }

  .category:last-child {
    border-block-end: var(--stroke) solid var(--border-faint);
  }

  /* The whole two-line block is the click target. */
  .category__summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    cursor: pointer;

    /* Drop the native disclosure triangle in favour of the marker below,
       which is mono and matches the rest of the page's furniture. */
    list-style: none;
  }

  .category__summary::-webkit-details-marker {
    display: none;
  }

  .category__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  /* `+` closed, `-` open. Both are one mono cell, so the name never shifts.
     No rotation, no transition — the site animates nothing but the cursor. */
  .category__marker,
  .subcategory__marker {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-mark);
    line-height: var(--lh-snug);
    color: var(--comment-mark);
  }

  .category__marker::before,
  .subcategory__marker::before {
    content: '+';
  }

  .category[open] > .category__summary .category__marker::before,
  .subcategory[open] > .subcategory__summary .subcategory__marker::before {
    content: '-';
  }

  /* The category's hue, on the name — the same place a section wears its own.
     Set inline on the <details> above, from the data file. Subcategories
     inherit it via currentColor rather than getting a style attribute of
     their own, since they never carry a colour of their own to set. */
  .category__name {
    font-family: var(--font-mono);
    font-size: var(--fs-mark);
    font-weight: var(--fw-medium);
    line-height: var(--lh-snug);
    color: var(--category-color);
  }

  .category__summary:hover .category__name {
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-decoration-thickness: var(--underline-thickness);
    text-underline-offset: var(--underline-offset);
  }

  .category__count {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    line-height: var(--lh-snug);
    color: var(--text-fainter);
    border: var(--hairline) solid var(--border);
    border-radius: var(--radius-pill);
    padding: var(--pill-pad-y) var(--pill-pad-x);
  }

  /* Indented to clear the marker cell, so it lines up under the name. */
  .category__blurb {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    line-height: var(--lh-snug);
    color: var(--text-comment);
    padding-inline-start: calc(var(--fs-mark) + var(--space-sm));
    max-width: var(--measure);
  }

  .category__body {
    padding-block-start: var(--space-lg);
    padding-inline-start: calc(var(--fs-mark) + var(--space-sm));
  }

  .link-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* --- Subcategories: the same disclosure pattern, one level in --------- */

  .subcategories {
    display: flex;
    flex-direction: column;
  }

  .subcategory {
    border-block-start: var(--hairline) solid var(--border-faint);
    padding-block: var(--space-md);
  }

  .subcategory:first-child {
    border-block-start: none;
    padding-block-start: 0;
  }

  .subcategory__summary {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-sm);
    cursor: pointer;
    list-style: none;
  }

  .subcategory__summary::-webkit-details-marker {
    display: none;
  }

  /* Smaller than a category name — the visual weight says "one level down"
     without needing any decoration beyond size. */
  .subcategory__name {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    font-weight: var(--fw-medium);
    line-height: var(--lh-snug);
    color: var(--category-color);
  }

  .subcategory__summary:hover .subcategory__name {
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-decoration-thickness: var(--underline-thickness);
    text-underline-offset: var(--underline-offset);
  }

  .subcategory__blurb {
    flex-basis: 100%;
    font-family: var(--font-mono);
    font-size: var(--fs-tiny);
    color: var(--text-comment);
  }

  .subcategory > .link-list {
    padding-block-start: var(--space-md);
    padding-inline-start: calc(var(--fs-meta) + var(--space-sm));
  }
</style>
