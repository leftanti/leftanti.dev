---
/** /hunting — threat hunting listing. Thin wrapper; see SectionLayout. */
import SectionLayout from '../../layouts/SectionLayout.astro';
import { getSection } from '../../config/sections';
import { getSectionItems } from '../../lib/timeline';

const section = getSection('hunting');
const items = await getSectionItems(section);
---

