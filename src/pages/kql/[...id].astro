---
/**
 * /kql/<id> — one KQL library entry.
 *
 * A thin wrapper around EntryLayout. Copy this file verbatim for a new
 * collection and change the two collection keys.
 *
 * `[...id]` rather than `[id]` because the glob loader derives ids from paths,
 * so entries filed in subfolders have slashes in them.
 */
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getSection } from '../../config/sections';
import { isPublished, itemForEntry } from '../../lib/timeline';

export async function getStaticPaths() {
  const entries = await getCollection('kql');
  return entries
    .filter((entry) => isPublished(entry.data))
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'kql'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const section = getSection('kql');
---

<EntryLayout item={itemForEntry(section, entry)} description={entry.data.description}>
  <Content />
</EntryLayout>
